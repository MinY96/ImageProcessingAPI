# (frontend will be added later)
# ------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/

# Vite / frontend build cache
.vite/
*.tsbuildinfo

# Node / npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local frontend environment files
frontend/.env
frontend/.env.*
!frontend/.env.example

# ------------------------------------------------------------
